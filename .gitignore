# ==========================================
# 1. PYTHON RUNTIME & BYTECODE RESIDUE
# ==========================================
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.coverage
htmlcov/

# ==========================================
# 2. LOCAL DATA STORAGE & TRANSIENT DB FILES
# ==========================================
# Keep the application codebase pure; never commit the active operational DB instances
src/app/production.db
src/app/production.db-wal
src/app/production.db-shm

# Target generic local databases if any extra testing nodes crop up
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite3
.fuse_hidden*

# Automated DB backups — these are full copies of production data and must
# never be committed (see src/app/services/db_backup_worker.py)
backups/

# Cross-process advisory lock files (see src/app/core/proc_lock.py)
locks/

# ==========================================
# 3. ENVIRONMENT & PACKAGING CONFIGURATIONS
# ==========================================
# Ignore the active virtual environment created by uv
.venv/
venv/
ENV/
*.env*
# ...but the placeholder template IS meant to be shared (contains no real
# secrets — verified) so new config options stay documented for the team.
!.env.example

# ==========================================
# 4. SYSTEM SPECIFIC & IDE CONFIGURATIONS
# ==========================================
.DS_Store
.idea/
.vscode/
*.swp
*.swo
*test.csv
parameters.csv
curltester.md

# ==========================================
# 5. TRANSIENT USER FILES / UPLOADS LOGS
# ==========================================
# Keeps your workspace data distinct from operational logs
*.log
PROJECT_CONTEXT.md
