[Unit]
Description=Kelioli AI Pilot Core FastAPI Backend Service
After=network.target

[Service]
User=ubuntu
Group=www-data
WorkingDirectory=/home/ubuntu/kelioli_pilot
Environment="PATH=/home/ubuntu/kelioli_pilot/.venv/bin"
ExecStart=/home/ubuntu/kelioli_pilot/.venv/bin/gunicorn -w 4 -k uvicorn.workers.UvicornWorker src.app.main:app --bind 127.0.0.1:8000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
