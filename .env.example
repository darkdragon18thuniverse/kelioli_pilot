# Kelioli AI Pilot Core - Environment Variable Configuration Template
# Duplicate this file to .env and set your environment-specific values.

# --- API Keys ---
SARVAM_API_KEY=your_sarvam_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# --- Security ---
JWT_SECRET_KEY=your_jwt_secret_key_here
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Storage & Database ---
DATABASE_PATH=kelioli_pilot.db
TEMP_AUDIO_DIR=./media/temp_audio

# --- Prepaid Billing ---
# When true (default), call intake (enqueue + CSV batch) and queue pickup are
# gated by an org's prepaid balance state (blocked -> 402 / queue skip).
# Set to false only during the cutover window between deploy and recording
# opening recharges (see PREPAID_BILLING_PLAN.md §5.3) — schema migration and
# ledger writes still occur regardless of this flag.
PREPAID_ENFORCEMENT_ENABLED=true

# --- Logging & Telemetry ---
LOG_LEVEL=INFO
LOG_FORMAT=text

# --- STT Service Configuration ---
MAX_RETRIES=3
RETRY_BACKOFF_FACTOR=2.0
STT_MIN_INTERVAL=1.05

# --- Outbound API Rate Limiting (shared across all gunicorn workers) ---
# Minimum seconds between Gemini requests. Must match the model's real RPM cap
# from AI Studio (https://aistudio.google.com/rate-limit), e.g. 15 RPM -> 4.0s.
GEMINI_MIN_INTERVAL=4.5
# Max seconds a request waits for a rate limit slot before proceeding anyway.
# Keep below nginx's proxy_read_timeout (default 60s).
RATE_LIMIT_MAX_WAIT=45.0

# --- OpenRouter Data Privacy ---
# "deny" routes only to providers that do not store or train on submitted data.
# Defaults to "allow" because most FREE models are hosted in exchange for prompt
# retention/training and become unroutable under "deny". Switch to "deny" when
# using paid models (e.g. deepseek/deepseek-v4-flash, where the cheapest
# provider is already compliant, so "deny" costs nothing).
OPENROUTER_DATA_COLLECTION=allow
# Stricter: restrict to Zero Data Retention endpoints only. Shrinks the
# provider pool considerably; enable after confirming routing stays stable.
OPENROUTER_REQUIRE_ZDR=false

# NOTE ON GEMINI PRIVACY: Google offers NO request parameter to opt out of
# training. On the free/unpaid quota, Google uses prompts and responses to
# improve its products and human reviewers may read them. Only a Cloud project
# with an ACTIVE BILLING ACCOUNT (paid tier) is excluded from training.
# Since call transcripts contain patient data, billing must be enabled.
# Ref: https://ai.google.dev/gemini-api/terms
